{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "isolatedModules": true,
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@kshetra/shared": ["../../packages/shared/src"]
    },
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
