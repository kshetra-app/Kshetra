# Kshetra media plane — copy to .env and edit. Keep .env OUT of git.
# ---------------------------------------------------------------------------

# Public IP / hostname the browsers & phones can reach the servers on.
# For local testing use your LAN IP (e.g. 192.168.1.20), NOT 127.0.0.1, so the
# phone on Wi-Fi can connect. For prod use your domain / floating IP.
PUBLIC_IP=127.0.0.1

# Host ports (change only if they clash with something already running)
MTX_RTMP_PORT=1935
MTX_SRT_PORT=8890
MTX_WHIP_PORT=8889
MTX_HLS_PORT=8888
SRS_HTTP_PORT=8080
EDGE_HTTP_PORT=80

# LiveKit dev keys — GENERATE REAL ONES for anything but local testing:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_KEYS=devkey:devsecretdevsecretdevsecretdevsecret

# ---------------------------------------------------------------------------
# App-side control plane (consumed by apps/mobile & apps/api selectPipeline()).
# These tell the router which public hosts to bake into the Live Event URLs.
# EXPO_PUBLIC_* are readable by the Expo app; mirror them in apps/api/.env too.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_MEDIA_SCHEME=https
EXPO_PUBLIC_MEDIA_INGEST_HOST=ingest.kshetra.example
EXPO_PUBLIC_MEDIA_SRS_HOST=srs.kshetra.example
EXPO_PUBLIC_MEDIA_OME_HOST=ome.kshetra.example
EXPO_PUBLIC_MEDIA_LIVEKIT_HOST=livekit.kshetra.example
EXPO_PUBLIC_MEDIA_EDGE_HOST=edge.kshetra.example

# Default publish protocol handed to the mobile broadcaster: rtmp | srt | whip
EXPO_PUBLIC_MEDIA_INGEST_PROTOCOL=rtmp

# Set to 'self_hosted' to activate real URLs; 'demo' keeps public test streams.
EXPO_PUBLIC_MEDIA_MODE=demo
