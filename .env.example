# ==============================================================================
# KSHETRA - Environment Template (.env.example)
# ==============================================================================

# Node / API Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Server-only Supabase Configuration (Railway API).
# Store the service-role key ONLY in the API environment secret manager.
# Never put SUPABASE_SERVICE_ROLE_KEY in any EXPO_PUBLIC_* or VITE_* variable.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace-with-server-side-anon-key-if-needed
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-secret

# Mobile App (Expo): publishable/anon key only; values are embedded in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Web Admin (Vite): public client key only; values are embedded in the web bundle.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Webhook worker/service (Railway worker environment).
DATABASE_URL=postgresql://user:password@host:5432/database
WEBHOOK_SECRETS_ENCRYPTION_KEY=exactly-64-hex-characters-32-bytes

