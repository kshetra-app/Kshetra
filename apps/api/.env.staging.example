# Environment: Staging
PORT=3001
HOST=0.0.0.0
NODE_ENV=staging
APP_ENV=staging

# Supabase Staging Project
SUPABASE_URL=https://staging-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
# Optional keyed pseudonymization for request IPs. Blank disables IP hashes in analytics.
ANALYTICS_IP_HASH_SECRET=
SUPABASE_ANON_KEY=your-staging-anon-key
# Required before enabling ad serving or telemetry; set a unique random value of 32+ bytes.
AD_VIEW_TOKEN_SECRET=

# Set provider credentials, the exact-model versioned rate card, and optional
# sourced INR conversion in the staging secret store before enabling AI calls.
AI_PROVIDER_RATE_CARD_JSON=
AI_USD_TO_INR_RATE=
AI_USD_TO_INR_RATE_SOURCE=

# Staging Allowed CORS Origins
CORS_ORIGINS=https://staging.kshetra.in,https://staging.panin.in,http://localhost:8081,http://localhost:3000

# Push Notifications (Staging Channel)
EXPO_ACCESS_TOKEN=your-staging-expo-token
