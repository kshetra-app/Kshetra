# Environment: Staging
PORT=3001
HOST=0.0.0.0
NODE_ENV=staging
APP_ENV=staging

# Supabase Staging Project
SUPABASE_URL=https://staging-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_ANON_KEY=your-staging-anon-key

# Staging Allowed CORS Origins
CORS_ORIGINS=https://staging.kshetra.in,https://staging.panin.in,http://localhost:8081,http://localhost:3000

# Push Notifications (Staging Channel)
EXPO_ACCESS_TOKEN=your-staging-expo-token
