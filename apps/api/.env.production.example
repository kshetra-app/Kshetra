# Environment: Production
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
APP_ENV=production

# Supabase Production Project
SUPABASE_URL=https://cxhyqjfelcwkavbqwqap.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
# Optional keyed pseudonymization for request IPs. Blank disables IP hashes in analytics.
ANALYTICS_IP_HASH_SECRET=
SUPABASE_ANON_KEY=your-production-anon-key
# Required before enabling ad serving or telemetry; set a unique random value of 32+ bytes.
AD_VIEW_TOKEN_SECRET=

# Set provider credentials, the exact-model versioned rate card, and optional
# sourced INR conversion in Railway secrets before enabling AI calls.
AI_PROVIDER_RATE_CARD_JSON=
AI_USD_TO_INR_RATE=
AI_USD_TO_INR_RATE_SOURCE=

# Production Allowed CORS Origins
CORS_ORIGINS=https://kshetra.in,https://www.kshetra.in,https://panin.in,https://www.panin.in,https://kshetra.app,https://www.kshetra.app,http://localhost:8081

# Push Notifications
EXPO_ACCESS_TOKEN=your-production-expo-token
