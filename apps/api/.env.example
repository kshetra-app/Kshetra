# ─── API Server ──────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Supabase (service role for server-side operations) ──────────
# Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI (Google Gemini) — required for KSHETRA AI features ───────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-key-here

# ─── Push Notifications (Expo) ───────────────────────────────────
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# ─── Observability & Operational Security (W004-R1 / W004-R1A) ────
# Dedicated monitoring credential for GET /api/metrics (required in production)
METRICS_AUTH_TOKEN=your-dedicated-metrics-auth-token-here

# Privileged internal bypass secret for GET /api/debug/error (min 16 chars)
DEBUG_BYPASS_SECRET=your-debug-bypass-secret-here
