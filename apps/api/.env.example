# ─── API Server ──────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Supabase (service role for server-side operations) ──────────
# Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional keyed pseudonymization for request IPs. Blank disables IP hashes in analytics.
ANALYTICS_IP_HASH_SECRET=
SUPABASE_ANON_KEY=your-anon-key-here
# Required before enabling ad serving or telemetry; generate a unique random value of 32+ bytes.
AD_VIEW_TOKEN_SECRET=
# Leave disabled until the active/ended political_ads RLS policy and table
# shape have been verified in the target Supabase environment.
POLITICAL_AD_PUBLIC_LIBRARY_ENABLED=false

# ─── AI (Google Gemini) — required for KSHETRA AI features ───────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-key-here

# Deployed AI providers stay unavailable until these are supplied from the
# active provider pricing schedule/contract. No application defaults are used.
# Rate-card keys must be "provider:exact-model-name" for enabled providers.
# Each rate contains promptUsdPerMillionTokens and completionUsdPerMillionTokens.
AI_PROVIDER_RATE_CARD_JSON=
# Optional; INR reporting is unavailable unless both values below are set.
AI_USD_TO_INR_RATE=
AI_USD_TO_INR_RATE_SOURCE=

# ─── Push Notifications (Expo) ───────────────────────────────────
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# ─── Observability & Operational Security (W004-R1 / W004-R1A) ────
# Dedicated monitoring credential for GET /api/metrics (required in production)
METRICS_AUTH_TOKEN=your-dedicated-metrics-auth-token-here

# Privileged internal bypass secret for GET /api/debug/error (min 16 chars)
DEBUG_BYPASS_SECRET=your-debug-bypass-secret-here
